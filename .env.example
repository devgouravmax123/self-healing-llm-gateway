# Application Environment Configuration Example
# Copy this file to .env and fill in local values.
# NEVER commit real credentials or secrets to git.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Redis (Operational State & Caching)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (Persistence & Durable Logs)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_gateway
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0

# LLM Providers (Local Ollama by default)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
PROVIDER_TIMEOUT=30.0

# Reliability / Retries
MAX_RETRIES=2
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=5.0
RETRY_JITTER=true

# Reliability / Circuit Breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30.0
CIRCUIT_HALF_OPEN_MAX_PROBES=1

# Reliability / Failover
MAX_FAILOVER_PROVIDERS=3

# Observability / OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=self-healing-llm-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=

# Chaos Testing & Administration (Development / Test only)
CHAOS_ENABLED=false
ADMIN_API_KEY=

# Optional Cloud Provider API Keys (Set in local .env only if testing cloud failover)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
